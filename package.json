{
  "name": "meridiano",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MERIDIANO — Comando Global: grande estratégia moderna em tempo real sobre um globo 3D real",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "build:deploy": "npm run build && node tools/deploy/split-large-data.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "sim:soak": "tsx src/app/soak.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@use-gesture/react": "^10.3.1",
    "cesium": "^1.147.0",
    "comlink": "^4.4.2",
    "flatgeobuf": "^4.6.1",
    "geojson-vt": "^5.0.4",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supercluster": "^9.1.0",
    "uplot": "^1.6.32",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/rbush": "^4.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0"
  }
}
