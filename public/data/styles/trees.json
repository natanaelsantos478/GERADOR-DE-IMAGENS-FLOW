{
  "version": 1,
  "doc": "Tree styles. species: model files under public/models/nature/<file>.glb with the native height (m) of the glb. rules (first match wins, last is a catch-all) are evaluated per land-cover polygon: cover (wood|scrub|park), min/maxAbsLat, min/maxElev (m). `mix` = weighted species; density = trees per m2 (before the per-tile budget); height = real-world height range (m) of the instances.",
  "species": {
    "oak": { "file": "oak", "nativeHeight": 6.98 },
    "pine": { "file": "pine", "nativeHeight": 9 },
    "birch": { "file": "birch", "nativeHeight": 6.49 },
    "palm": { "file": "palm", "nativeHeight": 5.97 },
    "bush": { "file": "bush", "nativeHeight": 0.63 }
  },
  "rules": [
    { "id": "scrub", "match": { "cover": ["scrub"] }, "mix": [{ "species": "bush", "weight": 1 }], "density": 0.0143, "height": [1.2, 2.2] },
    { "id": "alpine-forest", "match": { "cover": ["wood", "park"], "minElev": 2200 }, "mix": [{ "species": "pine", "weight": 19 }, { "species": "birch", "weight": 1 }], "density": 0.0167, "height": [10, 18] },
    { "id": "tropical-park", "match": { "cover": ["park"], "maxAbsLat": 25 }, "mix": [{ "species": "palm", "weight": 1 }, { "species": "oak", "weight": 1 }], "density": 0.0026, "height": [8, 15] },
    { "id": "tropical-forest", "match": { "cover": ["wood"], "maxAbsLat": 25 }, "mix": [{ "species": "oak", "weight": 4 }, { "species": "palm", "weight": 1 }], "density": 0.0167, "height": [11, 20] },
    { "id": "boreal-forest", "match": { "cover": ["wood", "park"], "minAbsLat": 50 }, "mix": [{ "species": "pine", "weight": 14 }, { "species": "birch", "weight": 5 }, { "species": "oak", "weight": 1 }], "density": 0.0167, "height": [12, 22] },
    { "id": "temperate-park", "match": { "cover": ["park"] }, "mix": [{ "species": "oak", "weight": 5 }, { "species": "birch", "weight": 3 }, { "species": "pine", "weight": 2 }], "density": 0.0026, "height": [9, 17] },
    { "id": "temperate-forest", "match": { "cover": ["wood"] }, "mix": [{ "species": "oak", "weight": 9 }, { "species": "birch", "weight": 4 }, { "species": "pine", "weight": 7 }], "density": 0.0167, "height": [10, 20] },
    { "id": "generic", "match": {}, "mix": [{ "species": "oak", "weight": 1 }], "density": 0.01, "height": [9, 16] }
  ]
}
