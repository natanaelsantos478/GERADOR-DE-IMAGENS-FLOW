; MERIDIANO — batalha próxima (ver docs/BATALHA_GODOT.md)
config_version=5

[application]

config/name="Meridiano Batalha"
run/main_scene="res://scenes/battle.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/use_taa=true
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
textures/default_filters/anisotropic_filtering_level=4
